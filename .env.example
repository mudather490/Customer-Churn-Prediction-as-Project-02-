# Copy to .env and run with: uvicorn app.main:app --env-file .env
# Relative paths are resolved from the project root.

# Path to the trusted joblib artifact exported from training.
CHURN_MODEL_PATH=models/customer_churn_model.joblib

# Application-level risk bands (independent of the 0.65 decision threshold).
RISK_LOW_MAX=0.30
RISK_HIGH_MIN=0.60

# Maximum customers accepted by POST /predict/batch.
MAX_BATCH_SIZE=1000

# DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO
